---
import Layout from '../../layouts/Layout.astro';
import { Image, getImage } from 'astro:assets';
import heroImg from '../../assets/rovar-frontpage.png';
import jenterImg from '../../assets/Jenter_forside_frontpage-1.jpg';
import boatImg from '../../assets/Bilde-Fjorled-JMT-1-e1593513975750.jpg';
import hotellImg from '../../assets/Hotell_Mork_frontpage.png';
import suggevagenImg from '../../assets/Suggevagen_frontpage.jpg';

const heroBg = await getImage({ src: heroImg, format: 'webp', width: 1600 });
---

<Layout title="Røvær – the island of opportunities" description="The small island community of Røvær lies a short boat trip from Haugesund." lang="en" page="home">
  <div class="hero" style={`background-image: url('${heroBg.src}');`}>
    <div class="hero-overlay">
      <h1>Røvær – the island of opportunities</h1>
      <p>The small island community of Røvær lies a short boat trip from Haugesund. A visit is like a journey back in time – to the island where the Vikings and the fishermen once lived.</p>
    </div>
  </div>

  <div class="page page-wide">
    <div class="card-grid">
      <a href="/en/explore/" class="card">
        <Image class="card-img" src={jenterImg} alt="Girls on Røvær" width={800} widths={[480, 800]} sizes="(max-width: 600px) 100vw, 460px" loading="eager" />
        <div class="card-body">
          <h2>Explore the island</h2>
          <p>Hikes, beaches, museum and food</p>
        </div>
      </a>
      <a href="/en/ferry/" class="card">
        <Image class="card-img" src={boatImg} alt="The express boat Fjordled" width={800} widths={[480, 800]} sizes="(max-width: 600px) 100vw, 460px" loading="eager" />
        <div class="card-body">
          <h2>Ferry</h2>
          <p>Today's departures between Haugesund and Røvær</p>
        </div>
      </a>
      <a href="/en/camp-school/" class="card">
        <Image class="card-img" src={hotellImg} alt="Røvær evening mood" width={800} widths={[480, 800]} sizes="(max-width: 600px) 100vw, 460px" loading="lazy" />
        <div class="card-body">
          <h2>Camp school</h2>
          <p>Outdoor life and coastal culture for pupils</p>
        </div>
      </a>
      <a href="/en/history/" class="card">
        <Image class="card-img" src={suggevagenImg} alt="Coastal landscape on Røvær" width={800} widths={[480, 800]} sizes="(max-width: 600px) 100vw, 460px" loading="lazy" />
        <div class="card-body">
          <h2>History of Røvær</h2>
          <p>From the Stone Age to a fishing community</p>
        </div>
      </a>
    </div>

    <p class="map-link">
      <a href="https://www.openstreetmap.org/#map=14/59.43816/5.09139" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" class="map-icon" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
        View Røvær on the map
      </a>
    </p>
  </div>
</Layout>
