---
import Layout from '../../layouts/Layout.astro';
import { routes } from '../../data/translations.js';
import { Image, getImage } from 'astro:assets';
import heroImg from '../../assets/rovar-frontpage.png';
import jenterImg from '../../assets/Jenter_forside_frontpage-1.jpg';
import boatImg from '../../assets/Bilde-Fjorled-JMT-1-e1593513975750.jpg';
import hotellImg from '../../assets/Hotell_Mork_frontpage.png';
import suggevagenImg from '../../assets/Suggevagen_frontpage.jpg';

const heroBg = await getImage({ src: heroImg, format: 'webp', width: 1600 });
---

<Layout title="Røvær – Insel der Möglichkeiten" description="Die kleine Inselgemeinschaft Røvær liegt eine kurze Bootsfahrt von Haugesund entfernt." lang="de" page="home">
  <div class="hero" style={`background-image: url('${heroBg.src}');`}>
    <div class="hero-overlay">
      <h1>Røvær – Insel der Möglichkeiten</h1>
      <p>Die kleine Inselgemeinschaft Røvær liegt eine kurze Bootsfahrt von Haugesund entfernt. Ein Besuch dort ist wie eine Reise zurück in der Zeit – zu der Insel, auf der einst die Wikinger und die Fischer lebten.</p>
    </div>
  </div>

  <div class="page page-wide">
    <div class="card-grid">
      <a href={routes.explore.de} class="card">
        <Image class="card-img" src={jenterImg} alt="Mädchen auf Røvær" width={800} widths={[480, 800]} sizes="(max-width: 600px) 100vw, 460px" loading="eager" />
        <div class="card-body">
          <h2>Die Insel entdecken</h2>
          <p>Wanderungen, Strände, Museum und Essen</p>
        </div>
      </a>
      <a href={routes.ferry.de} class="card">
        <Image class="card-img" src={boatImg} alt="Das Schnellboot Fjordled" width={800} widths={[480, 800]} sizes="(max-width: 600px) 100vw, 460px" loading="eager" />
        <div class="card-body">
          <h2>Fähre</h2>
          <p>Heutige Abfahrten zwischen Haugesund und Røvær</p>
        </div>
      </a>
      <a href={routes.campSchool.de} class="card">
        <Image class="card-img" src={hotellImg} alt="Røvær Abendstimmung" width={800} widths={[480, 800]} sizes="(max-width: 600px) 100vw, 460px" loading="lazy" />
        <div class="card-body">
          <h2>Schullandheim</h2>
          <p>Outdoor-Leben und Küstenkultur für Schüler</p>
        </div>
      </a>
      <a href={routes.history.de} class="card">
        <Image class="card-img" src={suggevagenImg} alt="Küstenlandschaft auf Røvær" width={800} widths={[480, 800]} sizes="(max-width: 600px) 100vw, 460px" loading="lazy" />
        <div class="card-body">
          <h2>Geschichte von Røvær</h2>
          <p>Von der Steinzeit zur Fischergemeinschaft</p>
        </div>
      </a>
    </div>

    <p class="map-link">
      <a href="https://www.openstreetmap.org/#map=14/59.43816/5.09139" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" class="map-icon" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
        Røvær auf der Karte ansehen
      </a>
    </p>
  </div>
</Layout>
