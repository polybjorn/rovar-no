---
import Layout from '../layouts/Layout.astro';
import { locales, defaultLocale } from '../i18n/locales.js';
import { pathFor } from '../i18n/routes.js';
import { ui } from '../i18n/ui.js';

const t = ui(defaultLocale).notFound;
---

<Layout title={t.title} description={t.intro} page="home">
  <div class="page">
    <h1 class="page-title">{t.title}</h1>
    <p class="page-intro">{t.intro}</p>
    <div class="section">
      {locales.map((l) => (
        <p lang={l.code}>
          <a href={pathFor('home', l.code)} hreflang={l.code}>{ui(l.code).notFound.homeLink}</a>
        </p>
      ))}
    </div>
  </div>
</Layout>
