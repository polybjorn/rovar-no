---
import Layout from '../layouts/Layout.astro';
import { locales, defaultLocale } from '../i18n/locales.js';
import { pathFor } from '../i18n/routes.js';
import { ui } from '../i18n/ui.js';

// One 404 page serves every language, since the host has no way of knowing
// which one the visitor was after. So each language says its own piece: the
// default language heads the page, the rest follow in full. In the browser,
// not-found.js narrows that to the language the URL names; without it the
// whole page stands, which is what a visitor with no language in their URL
// gets either way.
const t = ui(defaultLocale).notFound;
---

<Layout title={t.title} description={t.intro} page="home">
  <div class="page nf-page">
    {locales.map((l) => {
      const n = ui(l.code).notFound;
      const isDefault = l.code === defaultLocale;
      return (
        <section lang={l.code} class="section nf-lang">
          {isDefault ? <h1 class="page-title">{n.title}</h1> : <h2>{n.title}</h2>}
          <p class="page-intro">{n.intro}</p>
          <p><a href={pathFor('home', l.code)} hreflang={l.code}>{n.homeLink}</a></p>
        </section>
      );
    })}
  </div>
</Layout>

<script src="../scripts/not-found.js"></script>

<style>
  /* Nothing here scrolls, so the block sits in the middle of what is left
     between the header and the footer rather than hanging off the top. main is
     the only box that knows that height, and this stylesheet only ships with
     the 404 page. */
  :global(body > main) {
    display: flex;
  }

  .nf-page {
    margin: auto;
    text-align: center;
    /* Even padding: the site's page padding is bottom-heavy, which would push
       a centred block off centre. */
    padding-bottom: 2.5rem;
  }

  /* .page-intro is width-capped, so centring the text is not enough to centre
     the paragraph. */
  .nf-page .page-intro {
    margin-left: auto;
    margin-right: auto;
  }

  /* One language on screen needs no gap under it; three still want one. */
  .nf-lang:last-child {
    margin-bottom: 0;
  }
</style>
