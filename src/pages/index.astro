---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hjem" description="Røvær, øya utenfor Haugesund. Opplev natur, historie og kystkultur." page="home">
  <div class="hero" style="background-image: url('/images/rovar_forntpage.png');">
    <div class="hero-overlay">
      <h1>Mulighetenes Røvær</h1>
      <p>En kort båttur fra Haugesund ligger øya der vikingene og fiskerne en gang holdt til. Velkommen til Røvær.</p>
    </div>
  </div>

  <div class="page page-wide">
    <div class="card-grid">
      <a href="/opplev-oya-var/" class="card">
        <img class="card-img" src="/images/Jenter_forside_frontpage-1.jpg" alt="Jenter på Røvær">
        <div class="card-body">
          <h3>Opplev øya vår</h3>
          <p>Turer, strender, museum og mat</p>
        </div>
      </a>
      <a href="/rutebaten/" class="card">
        <img class="card-img" src="/images/Bilde-Fjorled-JMT-1-e1593513975750.jpg" alt="Hurtigbåten Fjordled">
        <div class="card-body">
          <h3>Rutebåten</h3>
          <p>Avganger i dag mellom Haugesund og Røvær</p>
        </div>
      </a>
      <a href="/leirskolen/" class="card">
        <img class="card-img" src="/images/Hotell_Mork_frontpage.png" alt="Røvær kveldsstemning" loading="lazy">
        <div class="card-body">
          <h3>Leirskolen</h3>
          <p>Friluftsliv og kystkultur for skoleelever</p>
        </div>
      </a>
      <a href="/rovaers-historie/" class="card">
        <img class="card-img" src="/images/Suggevagen_frontpage.jpg" alt="Kystlandskap på Røvær" loading="lazy">
        <div class="card-body">
          <h3>Røværs historie</h3>
          <p>Fra steinalder til fiskerisamfunn</p>
        </div>
      </a>
    </div>

    <p class="map-link">
      <a href="https://www.openstreetmap.org/#map=14/59.43816/5.09139" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" class="map-icon" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
        Se Røvær på kartet
      </a>
    </p>
  </div>
</Layout>

<style>
  .map-link {
    text-align: center;
    margin-top: 1.5rem;
  }

  .map-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.95rem;
    color: var(--color-ocean);
  }

  .map-icon {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
