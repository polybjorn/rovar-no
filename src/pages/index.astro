---
import Layout from '../layouts/Layout.astro';
import { Image, getImage } from 'astro:assets';
import heroImg from '../assets/rovar-frontpage.png';
import jenterImg from '../assets/Jenter_forside_frontpage-1.jpg';
import boatImg from '../assets/Bilde-Fjorled-JMT-1-e1593513975750.jpg';
import hotellImg from '../assets/Hotell_Mork_frontpage.png';
import suggevagenImg from '../assets/Suggevagen_frontpage.jpg';

const heroBg = await getImage({ src: heroImg, format: 'webp', width: 1600 });
---

<Layout title="Mulighetenes Røvær" description="Det lille øysamfunnet Røvær ligger en kort båttur fra Haugesund." page="home">
  <div class="hero" style={`background-image: url('${heroBg.src}');`}>
    <div class="hero-overlay">
      <h1>Mulighetenes Røvær!</h1>
      <p>Det lille øysamfunnet Røvær ligger en kort båttur fra Haugesund. Et besøk dit er som en reise tilbake i tid – til øya der vikingene og fiskerne en gang holdt til.</p>
    </div>
  </div>

  <div class="page page-wide">
    <div class="card-grid">
      <a href="/opplev-oya-var/" class="card">
        <Image class="card-img" src={jenterImg} alt="Jenter på Røvær" width={800} widths={[480, 800]} sizes="(max-width: 600px) 100vw, 460px" loading="eager" />
        <div class="card-body">
          <h2>Opplev øya vår</h2>
          <p>Turer, strender, museum og mat</p>
        </div>
      </a>
      <a href="/rutebaten/" class="card">
        <Image class="card-img" src={boatImg} alt="Hurtigbåten Fjordled" width={800} widths={[480, 800]} sizes="(max-width: 600px) 100vw, 460px" loading="eager" />
        <div class="card-body">
          <h2>Rutebåten</h2>
          <p>Avganger i dag mellom Haugesund og Røvær</p>
        </div>
      </a>
      <a href="/leirskolen/" class="card">
        <Image class="card-img" src={hotellImg} alt="Røvær kveldsstemning" width={800} widths={[480, 800]} sizes="(max-width: 600px) 100vw, 460px" loading="lazy" />
        <div class="card-body">
          <h2>Leirskolen</h2>
          <p>Friluftsliv og kystkultur for skoleelever</p>
        </div>
      </a>
      <a href="/rovaers-historie/" class="card">
        <Image class="card-img" src={suggevagenImg} alt="Kystlandskap på Røvær" width={800} widths={[480, 800]} sizes="(max-width: 600px) 100vw, 460px" loading="lazy" />
        <div class="card-body">
          <h2>Røværs historie</h2>
          <p>Fra steinalder til fiskerisamfunn</p>
        </div>
      </a>
    </div>

    <p class="map-link">
      <a href="https://www.openstreetmap.org/#map=14/59.43816/5.09139" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" class="map-icon" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
        Se Røvær på kartet
      </a>
    </p>
  </div>
</Layout>
