---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Rutebåten" description="Avgangstider for hurtigbåten mellom Haugesund og Røvær, linje 700.">
  <div class="page page-wide">
    <div class="dep-intro">
      <div>
        <h1 class="page-title">Rutebåten</h1>
        <p class="page-intro">
          Røvær har daglige forbindelser med hurtigbåt fra Haugesund (linje 700, Kolumbus).
          Turen tar omtrent 25 minutter.
        </p>
        <p class="dep-date-line" id="dep-date"></p>
      </div>
      <div class="dep-boat-wrap">
        <img class="dep-boat-img" src="/images/Bilde-Fjorled-JMT-1-e1593513975750.jpg" alt="Hurtigbåten Fjordled (Kolumbus)">
      </div>
    </div>

    <div class="dep-columns">
      <div class="dep-direction dep-to-haugesund">
        <div class="dep-header">Røvær → Haugesund</div>
        <div id="from-rovar"></div>
      </div>
      <div class="dep-direction dep-to-rovar">
        <div class="dep-header">Haugesund → Røvær</div>
        <div id="from-haugesund"></div>
      </div>
    </div>

    <p class="dep-booking">
      <svg class="dep-booking-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2z"/></svg> = Kan kreve forhåndsbestilling. Bestill via
      <a href="https://billetter.kolumbus.no" target="_blank" rel="noopener">billetter.kolumbus.no</a>
      eller ring 482 21 780.
    </p>

    <p class="dep-credit">
      Sanntidsdata fra <a href="https://entur.no/" target="_blank" rel="noopener">Entur</a>.
      Oppdateres automatisk hvert minutt.
      <span class="dep-kolumbus-sep">|</span>
      <a id="kolumbus-link" href="https://reise.kolumbus.no/no/search?fromId=NSR:StopPlace:25940&toId=NSR:StopPlace:26090" target="_blank" rel="noopener">Se ruter på Kolumbus</a>
    </p>
  </div>

  <script src="../scripts/departures.js"></script>
</Layout>

<style>
  .dep-intro {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 1rem;
  }

  .dep-boat-wrap {
    width: 280px;
    height: 180px;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .dep-boat-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 45%;
    scale: 1.4;
  }

  @media (max-width: 640px) {
    .dep-intro {
      flex-direction: column;
      gap: 1rem;
    }
    .dep-boat-wrap {
      width: 100%;
      height: 160px;
    }
  }

  .dep-date-line {
    font-size: 1rem;
    color: var(--color-text-light);
    margin-bottom: 0;
  }

  .dep-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 640px) {
    .dep-columns { grid-template-columns: 1fr; }
  }

  .dep-direction {
    background: var(--color-foam);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
  }

  .dep-header {
    padding: 0.85rem 1.25rem;
    font-weight: 600;
    font-size: 1rem;
    color: #fff;
    text-align: center;
  }

  .dep-to-haugesund .dep-header { background: var(--color-ocean); }
  .dep-to-rovar .dep-header { background: var(--color-kelp); }

  .dep-direction :global(.dep-list) {
    list-style: none;
    padding: 0.25rem 0;
  }

  .dep-direction :global(.dep-list li) {
    padding: 0.55rem 1.25rem;
    border-bottom: 1px solid var(--color-sand-dark);
  }

  .dep-direction :global(.dep-row) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .dep-direction :global(.dep-detail) {
    margin-top: 0.4rem;
    padding: 0.5rem 0.75rem;
    background: var(--color-sand);
    border-radius: 6px;
    font-size: 0.8rem;
    color: var(--color-text);
    line-height: 1.4;
  }

  .dep-direction :global(.dep-list li:last-child) {
    border-bottom: none;
  }

  .dep-direction :global(.dep-route) {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .dep-direction :global(.dep-time) {
    font-size: 1.05rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }

  .dep-direction :global(.dep-arrow) {
    color: var(--color-text-light);
    font-size: 0.85rem;
  }

  .dep-direction :global(.dep-arr) {
    font-size: 0.95rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-light);
  }

  .dep-direction :global(.dep-via) {
    font-size: 0.75rem;
    color: var(--color-text-light);
    white-space: nowrap;
  }

  .dep-direction :global(.dep-info) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .dep-direction :global(.dep-duration) {
    font-size: 0.8rem;
    color: var(--color-text-light);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .dep-direction :global(.dep-notice) {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    border: none;
    font-family: inherit;
  }

  .dep-direction :global(.dep-booking-notice) {
    background: var(--color-kelp);
    color: #fff;
    border-radius: 4px;
    padding: 0.2rem 0.4rem;
    gap: 0.25rem;
    font-size: 0.7rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .dep-direction :global(.dep-booking-notice svg) {
    width: 0.85rem;
    height: 0.85rem;
  }

  .dep-direction :global(.dep-info-notice) {
    background: var(--color-ocean-light);
    color: #fff;
    border-radius: 4px;
    padding: 0.2rem 0.4rem;
    gap: 0.25rem;
    font-size: 0.7rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .dep-direction :global(.dep-info-notice svg) {
    width: 0.85rem;
    height: 0.85rem;
  }

  .dep-direction :global(.passed .dep-time),
  .dep-direction :global(.passed .dep-arrow),
  .dep-direction :global(.passed .dep-arr),
  .dep-direction :global(.passed .dep-via),
  .dep-direction :global(.passed .dep-duration) {
    opacity: 0.35;
  }

  .dep-direction :global(.next) {
    background: rgba(0, 0, 0, 0.04);
    border-left: 3px solid transparent;
    padding-left: calc(1.25rem - 3px);
  }

  .dep-to-haugesund :global(.next) {
    border-left-color: var(--color-ocean);
  }

  .dep-to-rovar :global(.next) {
    border-left-color: var(--color-kelp);
  }

  .dep-to-haugesund :global(.next .dep-time) {
    color: var(--color-ocean);
    font-weight: 700;
  }

  .dep-to-rovar :global(.next .dep-time) {
    color: var(--color-kelp);
    font-weight: 700;
  }

  .dep-direction :global(.dep-loading),
  .dep-direction :global(.dep-empty),
  .dep-direction :global(.dep-error) {
    padding: 1.5rem 1.25rem;
    text-align: center;
    color: var(--color-text-light);
    font-size: 0.9rem;
  }

  .dep-direction :global(.dep-error) {
    color: #c0392b;
  }

  .dep-booking {
    font-size: 0.85rem;
    color: var(--color-text-light);
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .dep-booking-icon {
    width: 1rem;
    height: 1rem;
    color: var(--color-kelp);
    flex-shrink: 0;
  }

  .dep-credit {
    font-size: 0.85rem;
    color: var(--color-text-light);
  }

  .dep-kolumbus-sep {
    margin: 0 0.3rem;
    opacity: 0.4;
  }
</style>
