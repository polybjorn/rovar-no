---
interface Props {
  title: string;
  description?: string;
}

import '../styles/global.css';

const { title, description = "Øya utenfor Haugesund" } = Astro.props;
const currentPath = Astro.url.pathname;

const nav = [
  { href: "/opplev-oya-var/", label: "Opplev øya" },
  { href: "/rutebaten/", label: "Rutebåten" },
  { href: "/leirskolen/", label: "Leirskolen" },
  { href: "/rovaers-historie/", label: "Historie" },
];
---

<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | Røvær</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src https://api.entur.io; font-src 'self'; base-uri 'self'; form-action 'self'">
  <meta name="referrer" content="no-referrer">
</head>
<body>
  <a href="#main" class="skip-link">Hopp til innhold</a>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo"><img src="/images/rovar-logo.png" alt="Røvær" class="nav-logo-img"></a>
      <button class="nav-toggle" aria-label="Meny" aria-expanded="false">&#9776;</button>
      <ul class="nav-links">
        {nav.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={currentPath === href ? "page" : undefined}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <p><a href="mailto:rovaroyting@rovar.no">rovaroyting@rovar.no</a></p>
  </footer>

  <script src="../scripts/nav.js"></script>
</body>
</html>

