---
interface Props {
  title: string;
  description?: string;
  lang?: string;
  page?: string;
}

import '../styles/global.css';
import { Image, getImage } from 'astro:assets';
import logoImg from '../assets/rovar-logo.png';
import heroImg from '../assets/rovar-frontpage.png';
import { t, routes, langFlags, langLabels } from '../data/translations.js';

const { title, description = "Øya utenfor Haugesund", lang = "no", page = "home" } = Astro.props;
const tr = t[lang];
const currentPath = Astro.url.pathname;
const site = (Astro.site?.href ?? 'https://rovar.no/').replace(/\/$/, '');
const canonical = `${site}${currentPath}`;
const pageTitle = page === 'home' ? title : `${title} | Røvær`;
const ogLocales = { no: 'nb_NO', en: 'en_GB', de: 'de_DE' };
// Same params as the homepage hero, so the preload and the CSS background
// resolve to one asset.
const ogImage = await getImage({ src: heroImg, format: 'webp', width: 1600 });

const nav = [
  { href: routes.explore[lang], label: tr.navExplore },
  { href: routes.ferry[lang], label: tr.navFerry },
  { href: routes.campSchool[lang], label: tr.navCampSchool },
  { href: routes.history[lang], label: tr.navHistory },
];

const homeHref = routes.home[lang];
const pageRoutes = routes[page];
const langOrder = ['no', 'en', 'de'];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="canonical" href={canonical}>
  <link rel="sitemap" href="/sitemap-index.xml">
  {page === 'home' && <link rel="preload" as="image" href={ogImage.src} />}
  {Object.entries(pageRoutes).map(([l, path]) => (
    <link rel="alternate" hreflang={l} href={`${site}${path}`} />
  ))}
  <link rel="alternate" hreflang="x-default" href={`${site}${pageRoutes.no}`} />
  <meta property="og:site_name" content="Røvær">
  <meta property="og:type" content="website">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={`${site}${ogImage.src}`}>
  <meta property="og:locale" content={ogLocales[lang]}>
  <meta name="twitter:card" content="summary_large_image">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src https://api.entur.io; font-src 'self'; base-uri 'self'; form-action 'self'">
  <meta name="referrer" content="no-referrer">
</head>
<body>
  <a href="#main" class="skip-link">{tr.skipLink}</a>
  <nav class="nav">
    <div class="nav-inner">
      <a href={homeHref} class="nav-logo"><Image src={logoImg} alt="Røvær" height={58} class="nav-logo-img" loading="eager" /></a>
      <button class="nav-toggle" aria-label={tr.menuLabel} aria-expanded="false" aria-controls="nav-links">&#9776;</button>
      <ul class="nav-links" id="nav-links">
        {nav.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={currentPath === href ? "page" : undefined}>
              {label}
            </a>
          </li>
        ))}
        <li class="lang-switcher">
          {langOrder.map(l => l === lang ? (
            <span class="lang-current" aria-label={langLabels[l]}>
              <img src={langFlags[l]} alt={langLabels[l]} width="20" height="15">
            </span>
          ) : (
            <a href={pageRoutes[l]} class="lang-link" aria-label={langLabels[l]}>
              <img src={langFlags[l]} alt={langLabels[l]} width="20" height="15">
            </a>
          ))}
        </li>
      </ul>
    </div>
  </nav>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <p>{tr.footerPre} <a href="mailto:rovaroyting@rovar.no">rovaroyting@rovar.no</a> {tr.footerPost}</p>
  </footer>

  <script src="../scripts/nav.js"></script>
</body>
</html>
