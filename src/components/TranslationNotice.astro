---
interface Props {
  lang: string;
  file: string;
}

import { ui } from '../i18n/ui.js';
import { editUrl } from '../data/site.js';

const { lang, file } = Astro.props;
const t = ui(lang).translation;
---

<p class="mt-notice">
  {t.notice}
  <a href={editUrl(file)} target="_blank" rel="noopener">{t.suggest}</a>
</p>

<style>
  .mt-notice {
    background: var(--color-foam);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.6rem 0.9rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    color: var(--color-text-light);
  }
</style>
